# Capture Vector — local environment template.
# Copy to `.env` for your shell, or export the values directly. `.env` is
# gitignored; this template is the documented contract.
#
# Nothing here is required to browse a workspace. The app discloses an
# absent engine instead of failing.

# Boris 0.9.0 binary. Discovery order: CV_BORIS_BIN -> bundled -> PATH
# -> opt-in sibling checkout (CV_BORIS_SIBLING=1).
CV_BORIS_BIN=

# boris-migration-lab binary (the Migrate utility). Same discovery order:
# CV_MIGRATION_LAB_BIN -> bundled -> PATH -> opt-in sibling checkout
# (CV_MIGRATION_LAB_SIBLING=1). scripts/fetch-migration-lab.sh builds the
# pinned one into vendor/boris-migration-lab/zig-out/bin/.
CV_MIGRATION_LAB_BIN=

# Workspace opened at launch. Same precedence as `--project`: flag wins.
CV_PROJECT=

# Page to open in the editor at launch, relative to the workspace.
CV_EDIT=

# Per-user config dir (recent workspaces). Tests and portable installs use
# this to avoid touching the real config dir.
CV_CONFIG_DIR=

# Vendor a different pinned rune revision (scripts/fetch-rune.sh only).
CV_RUNE_REV=

# Unique agent/session identity used by scripts/agent-claim.py when --agent
# is not passed. Example: a Devin session id or user-machine-name.
CV_AGENT=

# Structured JSONL logging: error|warn|info|debug|trace. Empty disables.
CV_LOG=
# Optional log file; defaults to stderr.
CV_LOG_FILE=

# Golden/regression helpers (tests only).
CV_BLESS=
CV_REF_SCALE=
CV_REF_OUT=

# Publish secrets are NOT read from this file. The engine receives them on
# stdin only, never argv/env/logs; see AGENTS.md "Hard rules".

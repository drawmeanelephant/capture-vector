      ],
      "role": "text",
      "text": "{\n  \"format\": \"boris-publication-profile\",\n  \"schema_version\": 1,\n  \"input\": \"content\",\n  \"targets\": [\n    { \"name\": \"public\", \"output\": \"dist\", \"public\": true, \"theme\": \"themes/boris\" }\n  ]\n}"
    },

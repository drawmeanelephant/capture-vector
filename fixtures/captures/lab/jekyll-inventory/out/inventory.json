{
  "format": "boris-jekyll-migration-lab",
  "schema_version": 1,
  "mode": "inventory",
  "tool_version": "0.1.0",
  "source": {
    "root": "/CAPTURE_ROOT/src/mini-jekyll"
  },
  "config": {
    "title": "Mini Jekyll Fixture",
    "baseurl": "",
    "permalink": "pretty",
    "collections": [
      { "name": "docs", "output": true, "members": ["_docs/guide-one.md", "_docs/guide-two.md"] },
      { "name": "internal", "output": false, "members": ["_internal/checklist.md"] }
    ]
  },
  "posts": [
    { "path": "_posts/2024-01-02-welcome-post.md", "date": "2024-01-02", "slug": "welcome-post", "title": "Welcome Post", "status": "published"},
    { "path": "_posts/2024-02-10-permalink-post.md", "date": "2024-02-10", "slug": "permalink-post", "title": "Permalink Post", "status": "published"},
    { "path": "_posts/2024-03-15-unpublished-post.md", "date": "2024-03-15", "slug": "unpublished-post", "title": "Unpublished Post", "status": "draft"}
  ],
  "unmatched_posts": [
    { "path": "_posts/no-date.md", "title": "Not A Post"}
  ],
  "drafts": [
    { "path": "_drafts/draft-notes.md", "title": "Draft Notes"}
  ],
  "pages": [
    { "path": "about.md", "title": "About", "permalink": "/about/"},
    { "path": "index.md", "title": "Home", "permalink": null}
  ],
  "frontmatter_keys": ["categories", "layout", "permalink", "published", "tags", "title"],
  "liquid_tags": [
    { "name": "include", "count": 1 },
    { "name": "link", "count": 2 },
    { "name": "post_url", "count": 3 },
    { "name": "site.baseurl", "count": 1 },
    { "name": "site.data.team", "count": 2 }
  ],
  "data_refs": [
    { "name": "site.data.team", "file": "_data/team.yml", "exists": true, "count": 2 }
  ],
  "layouts": ["_layouts/default.html", "_layouts/post.html"  ],
  "include_files": ["_includes/note.html"  ],
  "plugins": ["_plugins/shout_filter.rb"  ],
  "data_files": ["_data/team.yml"  ],
  "static_files": ["README.md", "assets/images/hero.png"  ],
  "ignored": [],
  "constructs": [
    { "construct": "_posts/YYYY-MM-DD-slug.md", "class": "transformed", "count": 3 },
    { "construct": "_posts/ file not matching YYYY-MM-DD-slug", "class": "human_review", "count": 1 },
    { "construct": "_drafts/*.md", "class": "transformed", "count": 1 },
    { "construct": "published: false", "class": "transformed", "count": 1 },
    { "construct": "permalink frontmatter", "class": "transformed", "count": 2 },
    { "construct": "categories frontmatter", "class": "transformed", "count": 2 },
    { "construct": "tags frontmatter", "class": "exact", "count": 3 },
    { "construct": "layout frontmatter / _layouts/", "class": "unsupported", "count": 4 },
    { "construct": "_includes/ + {% include %}", "class": "unsupported", "count": 2 },
    { "construct": "_plugins/*.rb", "class": "unsupported", "count": 1 },
    { "construct": "Custom collection with output: true (_docs/ etc.)", "class": "transformed", "count": 2 },
    { "construct": "Custom collection with output: false", "class": "unsupported", "count": 1 },
    { "construct": "_data/*.yml referenced via {{ site.data.<file>.<key> }}", "class": "transformed", "count": 2 },
    { "construct": "{% post_url YYYY-MM-DD-slug %} (resolves)", "class": "transformed", "count": 2 },
    { "construct": "{% post_url %} (broken target)", "class": "human_review", "count": 1 },
    { "construct": "{% link path %} (resolves)", "class": "transformed", "count": 2 },
    { "construct": "{% link %} (broken target)", "class": "human_review", "count": 0 },
    { "construct": "{{ site.baseurl }}", "class": "transformed", "count": 1 },
    { "construct": "{% raw %}…{% endraw %}", "class": "exact", "count": 1 },
    { "construct": "Liquid tag inside a fenced code block", "class": "exact", "count": 1 },
    { "construct": "Other {% … %} / {{ … }} Liquid", "class": "human_review", "count": 0 },
    { "construct": "Plain top-level page (*.md outside _posts, _drafts, collections)", "class": "transformed", "count": 2 },
    { "construct": "assets/ and other static files", "class": "transformed", "count": 2 },
    { "construct": "_config.yml", "class": "transformed", "count": 1 }
  ]
}
